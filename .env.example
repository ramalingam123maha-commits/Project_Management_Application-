# Copy this file to `.env` and change every value marked CHANGE-ME.
# `.env` is gitignored; never commit real secrets.

# --- Database ---
DB_NAME=projectflow
DB_USER=projectflow
DB_PASSWORD=CHANGE-ME
DB_ROOT_PASSWORD=CHANGE-ME

# --- Backend ---
# Base64 string of at least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=CHANGE-ME
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# First Admin account, created on first start if no such user exists.
ADMIN_INITIAL_NAME=System Administrator
ADMIN_INITIAL_EMAIL=admin@projectflow.local
ADMIN_INITIAL_PASSWORD=CHANGE-ME

# --- Web ---
# Port the app is published on
WEB_PORT=3000
